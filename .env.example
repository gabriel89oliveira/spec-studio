# Pasta do projeto, com CLAUDE.md e docs/ (caminho absoluto)
# Windows: PROJECT_DIR=C:\Users\Gabriel\Projetos\driveb-spec
PROJECT_DIR=

# Chave da API da Anthropic (https://console.anthropic.com). Sem ela, a aplicação abre com o Claude desativado.
ANTHROPIC_API_KEY=

# Alias ou nome completo do modelo
CLAUDE_MODEL=sonnet

# Nome usado como autor de comentários e commits manuais
USER_NAME=Gabriel

# Porta do servidor
PORT=3001

# Commit automático de cada alteração (true/false)
AUTO_COMMIT=true
