# Pasta do projeto inicial, com CLAUDE.md e docs/ (caminho absoluto). Opcional: dá para escolher
# ou criar projetos pela tela (clique no nome do projeto no cabeçalho). O último projeto aberto
# pela tela é reaberto ao reiniciar.
# Windows: PROJECT_DIR=C:\Users\Gabriel\Projetos\driveb-spec
PROJECT_DIR=

# Chave da API da Anthropic (https://console.anthropic.com). Sem ela, a aplicação abre com o Claude desativado.
ANTHROPIC_API_KEY=

# Gateway de LLM (opcional). Se você acessa o modelo da Anthropic por um gateway da empresa
# (LiteLLM, Azure APIM, Kong etc.), deixe ANTHROPIC_API_KEY vazio e preencha estes campos:
#   ANTHROPIC_AUTH_TOKEN  token do gateway (enviado como "Authorization: Bearer ...")
#   ANTHROPIC_BASE_URL    endereço do gateway, ex.: https://gateway.suaempresa.com
#   ANTHROPIC_CUSTOM_HEADERS  cabeçalhos extras, um "Nome: valor" por linha (se o gateway exigir)
# Se o gateway usar x-api-key em vez de Bearer, ponha o token em ANTHROPIC_API_KEY.
# Se o gateway recusar a requisição por causa de recursos beta, acrescente CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1.
# Os nomes dos modelos podem ser diferentes no gateway: use o nome exato dele em CLAUDE_MODEL.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_CUSTOM_HEADERS=

# Alias ou nome completo do modelo (haiku custa bem menos que sonnet)
CLAUDE_MODEL=sonnet

# Modo simulado: true usa um Claude de mentira, sem custo, para testar a interface.
# As alterações são reais e marcadas como "modo simulado"; desfaça pelo Histórico.
CLAUDE_MOCK=false

# Nome usado como autor de comentários e commits manuais
USER_NAME=Gabriel

# Porta do servidor
PORT=3001

# Commit automático de cada alteração (true/false)
AUTO_COMMIT=true
